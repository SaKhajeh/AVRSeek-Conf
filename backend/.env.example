# AvalAI (OpenAI-compatible) — recommended for Claude Opus 5 in Iran
OPENAI_API_KEY=YOUR_AVALAI_API_KEY
OPENAI_BASE_URL=https://api.avalai.ir/v1

# Alternative: GapGPT / any OpenAI-compatible endpoint
# OPENAI_API_KEY=YOUR_GAPGPT_API_KEY
# OPENAI_BASE_URL=https://api.gapgpt.app/v1

# Per-task models (change freely)
MODEL_TEXT=claude-opus-5
MODEL_VLM=claude-opus-5
MODEL_STANDARDIZE=claude-opus-5

# OCR / vision
ENABLE_OCR=true
ENABLE_VLM_PAGE_READ=true
OCR_LANGUAGES=eng+rus+chi_sim+chi_tra
# false = always reprocess the same PDF (dev). true = skip duplicates by content hash.
ENABLE_RESULT_CACHE=false
# Optional local OCSR: rxnscribe | molscribe
OCSR_LOCAL_MODEL=

# Server
AVRSEEK_HOST=127.0.0.1
AVRSEEK_PORT=8765
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
