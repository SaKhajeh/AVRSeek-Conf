                                    <pdfaField:valueType>Real</pdfaField:valueType>
                                    <pdfaField:description>Number of pages of a given DocumentSection</pdfaField:description>
                                 </rdf:li>
                              </rdf:Seq>
                           </pdfaType:field>
                        </rdf:li>
