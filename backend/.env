# AvalAI (OpenAI-compatible) — primary provider
OPENAI_API_KEY=aa-SCVSbwKNhinMVoLdq0JTQ8WASclghDJeYC7ZVYi7iIGaXBvT
OPENAI_BASE_URL=https://api.avalai.ir/v1

# Alternative: GapGPT
# OPENAI_API_KEY=YOUR_GAPGPT_API_KEY
# OPENAI_BASE_URL=https://api.gapgpt.app/v1

# Per-task models
MODEL_TEXT=claude-opus-5
MODEL_VLM=claude-opus-5
MODEL_STANDARDIZE=claude-opus-5

# OCR / vision
ENABLE_OCR=true
ENABLE_VLM_PAGE_READ=true
OCR_LANGUAGES=eng+rus+chi_sim+chi_tra
ENABLE_RESULT_CACHE=false
OCSR_LOCAL_MODEL=

# Server
AVRSEEK_HOST=127.0.0.1
AVRSEEK_PORT=8765
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
